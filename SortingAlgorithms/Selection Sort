#include <stdlib.h>
#include <stddef.h>

void selectionSort(int arr[], int size) {
    if (arr == NULL || size <= 1)
        return;

    for (int i = 0; i < size - 1; i++)
    {
         int minIndex = i;
         for (int j = i + 1; j < size; j++)
            if (arr[j] < arr[minIndex])
                minIndex = j;

    if (minIndex != i)
        {
            int temp = arr[i];
            arr[i] = arr[minIndex];
            arr[minIndex] = temp;
        }
    }
} 