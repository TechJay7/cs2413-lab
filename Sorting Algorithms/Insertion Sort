#include <stdlib.h>
#include <stddef.h>

void insertionSort(int arr[], int size) {
    if (arr == NULL || size <= 1)
        return;

    for (int i = 1; i < size; i++)
    {
        int current = arr[i];
        int j = i - 1;

        while (j >= 0 && arr[j] > current)
        {
            arr[j + 1] = arr[j]; 
            j--;
        }

        arr[j + 1] = current;
    }
}